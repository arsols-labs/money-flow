{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"],
    // The UI is JS/JSX and is not part of tsc; money.js, language.js, and
    // theme.js are exceptions: tests import them, and without allowJs the
    // import is not resolved.
    "allowJs": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "../src/worker/**/*.ts",
    "../src/worker/**/*.d.ts",
    "../src/shared/**/*.ts",
    "../src/ui/money.js",
    "../src/ui/language.js",
    "../src/ui/theme.js",
    "../src/ui/i18n.js",
    "../src/ui/locales/*.json"
  ]
}
