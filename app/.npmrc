# @cloudflare/vitest-plugin@1.3.6 (successor of @cloudflare/vitest-pool-workers@0.22.0)
# still peers vitest ^4.1.0. No published release accepts vitest 5. The plugin
# warns outside that range and hard-fails only on vitest 3. legacy-peer-deps
# lets `npm ci` install vitest 5 without a CLI flag. scripts/patch-vitest-plugin-import-meta.mjs
# then fixes the plugin's import.meta.url rewrite so Vitest 5 can parse in workerd.
legacy-peer-deps=true
