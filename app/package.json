{
  "name": "money-flow",
  "version": "2.25.8",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-vitest-plugin-import-meta.mjs",
    "icons": "node scripts/generate-app-icons.mjs",
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run && npm run test:setup",
    "test:setup": "node --test scripts/lib/cloudflare-setup/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:local": "npm run build && wrangler deploy --config wrangler.local.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply money-flow-db --local",
    "db:migrate": "wrangler d1 migrations apply money-flow-db --remote",
    "db:seed:dev:mcp": "wrangler d1 execute money-flow-db --remote --file=./scripts/seed-mcp-data.sql"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.9",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "4.146.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
