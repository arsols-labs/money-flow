{
  // Public / CI config for Money Flow. Vitest (@cloudflare/vitest-pool-workers) and
  // local miniflare read this file. Binding ids below are placeholders for CI —
  // not production Cloudflare resources. Strangers: run `npm run setup` to create
  // gitignored wrangler.local.jsonc with your own D1/KV. See wrangler.template.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "money-flow",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/.well-known/*"]
  },
  "kv_namespaces": [
    { "binding": "KV", "id": "00000000000000000000000000000001" },
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000002" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "money-flow-db",
      "database_id": "00000000-0000-4000-8000-000000000001"
    }
  ],
  "vars": {
    "APP_DOMAIN": "localhost"
  },
  "ratelimits": [
    { "name": "RATE_LIMIT_OAUTH_REGISTER", "namespace_id": "100001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH_SETUP", "namespace_id": "100002", "simple": { "limit": 8, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH_LOGIN", "namespace_id": "100003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMIT_MCP_DISPATCH", "namespace_id": "100004", "simple": { "limit": 60, "period": 60 } }
  ]
}
